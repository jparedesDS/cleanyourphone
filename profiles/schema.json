{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CleanYourPhone profile",
  "type": "object",
  "required": ["id", "brand", "model", "android", "fingerprint_regex", "verification", "tested", "disable", "ask", "never", "notes"],
  "additionalProperties": true,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "brand": {"type": "string", "minLength": 1},
    "model": {"type": "string", "minLength": 1},
    "marketing_name": {"type": "string"},
    "codename": {"type": "string"},
    "android": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "fingerprint_regex": {"type": "string"},
    "generic": {"type": "boolean"},
    "form_factor": {
      "type": "string",
      "enum": ["phone", "tablet"],
      "default": "phone"
    },
    "auto_apply": {"type": "boolean", "default": true},
    "verification": {
      "type": "string",
      "enum": ["device", "documented", "reference"],
      "default": "device"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "url", "retrieved"],
        "properties": {
          "title": {"type": "string", "minLength": 1},
          "url": {"type": "string", "pattern": "^https?://"},
          "retrieved": {"type": "string", "minLength": 1},
          "note": {"type": "string"}
        }
      }
    },
    "tested": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "required": ["android", "build", "date", "by"],
        "properties": {
          "android": {"type": "string"},
          "build": {"type": "string"},
          "date": {"type": "string"},
          "by": {"type": "string"}
        }
      }
    },
    "disable": {
      "type": "array",
      "items": {"$ref": "#/definitions/change"}
    },
    "ask": {
      "type": "array",
      "items": {"$ref": "#/definitions/change"}
    },
    "never": {
      "type": "array",
      "items": {"$ref": "#/definitions/keep"}
    },
    "notes": {"type": "string", "minLength": 1}
  },
  "definitions": {
    "change": {
      "type": "object",
      "required": ["package", "why", "breaks"],
      "properties": {
        "package": {"type": "string", "minLength": 1},
        "why": {"type": "string", "minLength": 1},
        "breaks": {"type": "string", "minLength": 1}
      }
    },
    "keep": {
      "type": "object",
      "required": ["package", "why"],
      "properties": {
        "package": {"type": "string", "minLength": 1},
        "why": {"type": "string", "minLength": 1},
        "breaks": {"type": "string"}
      }
    }
  }
}
